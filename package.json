{
  "name": "skyseed-isles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Skyseed Isles — endless kid-first 3D platformer with accounts and saved progress.",
  "scripts": {
    "check": "node --input-type=module --check < play/game.js && node --input-type=module --check < play/i18n.js && node --check play/account.js && node --check play/sw.js",
    "reset-parent": "node scripts/reset-parent-password.mjs",
    "serve": "node node_modules/http-server/bin/http-server -p 5610 -c-1 --silent .",
    "setup-db": "node scripts/setup-db.mjs",
    "test:badges": "node test/badges.test.mjs",
    "test:browser": "node test/browser.test.mjs",
    "test:controls": "node test/controls.test.mjs",
    "test:dungeon": "node test/dungeon.test.mjs",
    "test:family": "node test/family.test.mjs",
    "test:feel": "node test/feel.test.mjs",
    "test:graphics": "node test/graphics.test.mjs",
    "test:i18n": "node test/i18n.test.mjs",
    "test:interior": "node test/interior.test.mjs",
    "test:pad": "node test/pad-view.test.mjs",
    "test:portrait": "node test/portrait.test.mjs",
    "test:purchase": "node test/purchase.test.mjs",
    "test:quests": "node test/quests.test.mjs",
    "test:shop": "node test/shop.test.mjs",
    "test:signup": "node test/signup.test.mjs",
    "test:solids": "node test/solids.test.mjs",
    "test:vrm": "node test/vrm.test.mjs miru.vrm",
    "test:world": "node test/world.test.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@noble/curves": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "puppeteer-core": "^23.0.0"
  }
}
