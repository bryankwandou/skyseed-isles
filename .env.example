# Copy to .env.local and fill in. NEVER commit real secrets.
# Neon pooled connection string (from Neon dashboard / Vercel Storage tab)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Random 32+ char secret for signing session tokens (generate a fresh one)
AUTH_SECRET=change-me-to-a-long-random-string
# Google sign-in (optional). Until both are set, /api/google returns 503 and the
# "Continue with Google" button stays disabled as "coming soon".
# Get them at console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID (type: Web application). Add this Authorised redirect URI:
#   https://YOUR-DOMAIN/api/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed admin (used once by scripts/setup-db.mjs; never commit real values)
ADMIN_USERNAME=nayrbryanGaming
ADMIN_EMAIL=nayrbryangaming3@gmail.com
ADMIN_PASSWORD=set-at-runtime-only
